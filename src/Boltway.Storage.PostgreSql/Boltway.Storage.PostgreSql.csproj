<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PostgreSQL provider: the package references, the migrations, and the one class that says how
    this provider makes a read-decide-write sequence atomic.

    Thin on purpose, and the same shape as Boltway.Storage.Sqlite. Everything a store does lives
    in Boltway.Storage.EntityFrameworkCore; what is here is what cannot be written
    provider-neutrally.
  -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boltway.Storage.EntityFrameworkCore\Boltway.Storage.EntityFrameworkCore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!--
      Direct, not transitive. PostgreSqlRelationalStoreBehavior.IsUniqueViolation names
      PostgresException and PostgresErrorCodes, both of which live in Npgsql rather than in the EF
      provider. Relying on the transitive reference would compile today and break on any future
      version of the EF provider that stopped flowing it, and Directory.Packages.props pins Npgsql
      precisely so that "which Npgsql" is a decision recorded in one place.
    -->
    <PackageReference Include="Npgsql" />

    <!--
      Design-time only: `dotnet ef migrations add` needs it, a running server does not.
      PrivateAssets="all" keeps it out of the produced package, so a customer referencing
      Boltway.Storage.PostgreSql does not pull the migration scaffolder into their deployment.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

</Project>
