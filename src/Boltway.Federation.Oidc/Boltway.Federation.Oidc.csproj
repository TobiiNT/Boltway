<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The generic OpenID Connect relying-party leg: one upstream, any upstream.

    It is its own project rather than part of Boltway.AuthorizationServer, and rather than part
    of Boltway.Federation.Google, for two reasons that are checkable rather than aesthetic:

      * It does NOT reference Boltway.AuthorizationServer. So "the authorization server knows
        only the IExternalIdentityProvider abstraction, and a provider knows nothing about the
        server's endpoints, cookies or pipeline" is enforced by the compiler. A provider that could
        see the server could read the pending-request cookie.

      * Boltway.Federation.Google is left holding a configuration class and nothing else, which
        is what makes "Google is not special" a fact about the build rather than a claim in a design
        document. Adding Facebook or an enterprise OIDC provider is a project of that same size.
  -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>
      The generic OpenID Connect relying-party leg: signing a user in against any upstream identity
      provider, behind the IExternalIdentityProvider seam. It does not reference
      Boltway.AuthorizationServer, so a provider cannot reach the server's endpoints, cookies or
      pipeline.
    </Description>
  </PropertyGroup>

  <!--
    For Microsoft.Extensions.DependencyInjection.Abstractions and nothing else - the registration
    extension needs IServiceCollection. FrameworkReference rather than a PackageReference so the
    shared framework's own copy is used and there is no second one to disagree at a patch release.
    Nothing here touches ASP.NET Core itself; the architecture rule over System.Net.Http is what
    keeps that checkable rather than a promise.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boltway.AuthorizationServer.Abstractions\Boltway.AuthorizationServer.Abstractions.csproj" />
    <ProjectReference Include="..\Boltway.OAuth.Net\Boltway.OAuth.Net.csproj" />
    <ProjectReference Include="..\Boltway.OAuth.Primitives\Boltway.OAuth.Primitives.csproj" />
    <ProjectReference Include="..\Boltway.OAuth.Tokens\Boltway.OAuth.Tokens.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>

</Project>
