<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A non-persistent store, shipped rather than confined to a test project: a customer writing their
    own store needs something to compare against, and the shared contract suite needs a third
    implementation to prove the contract describes BEHAVIOUR rather than EF Core.
  -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>
      Non-persistent implementations of the authorization server's stores, shipped rather than confined
      to a test project so that somebody writing their own store has something to compare against. Per
      process and not durable: state is lost on restart and is not shared between replicas.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Boltway.AuthorizationServer.Abstractions\Boltway.AuthorizationServer.Abstractions.csproj" />
  </ItemGroup>

</Project>
