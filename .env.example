# Overrides for docker-compose.yml. Copy it if you want one:
#
#   cp .env.example .env
#
# **It is optional.** Every value below is the default already written into `docker-compose.yml`, so
# `docker compose up` with no `.env` at all stands the same stack up. Nothing here has to be filled
# in before the first run.
#
# Compose reads `.env` from this directory automatically and uses it for `${…}` substitution *in the
# compose file*. That is not the same as `env_file:`, which injects a file's contents into a
# container's environment - this stack uses neither, so a variable here only reaches a container
# because `docker-compose.yml` names it on an `environment:` line. Adding a setting is therefore two
# edits, and that is deliberate: the compose file stays the list of what the servers are configured
# with, rather than a file that passes through whatever it happens to be handed.
#
# `environment:` also wins over `env_file:` wherever both name a key, which is the other half of the
# same reason to keep the list in one place.

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# There are no secrets in this file, and that is a decision
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
# The stack needs three: a signing key ring, a refresh-token derivation key, and a client secret for
# the admin UI. All three are generated on first boot by the `init` service, using the verbs the
# authorization server ships for exactly that - `new-key`, `openssl`-equivalent randomness, and
# `new-client-secret` - and stored in a Docker volume on the machine that ran them.
#
# The alternative was to print a development RSA key here and mark it clearly. It was not taken:
#
#   * A private key in this file is a private key in the repository, in the one repository whose
#     subject is not doing that, and in the file every new deployment starts by copying.
#   * A key that is already typed is the key that reaches production. `SIGNING_KEYS` is not
#     validated against a blocklist and never could be - any RSA key is a valid one - so a server
#     signing with a key published on the internet issues tokens anyone can forge, passes every
#     health check, and reports nothing.
#   * The trap it would have avoided is a two-character one. `new-key <kid>` prints a single JSON
#     object and `SIGNING_KEYS` wants a JSON array; `init` wraps the output in brackets, which is
#     the whole of the fix, and it does it where a reader can see it.
#
# If you want to supply your own instead of using the generated ones, uncomment the three lines at
# the bottom of this file. The entrypoints prefer a value that is set.

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Names and ports
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
# `.localhost` because RFC 2606 §2 reserves it, browsers resolve `*.localhost` to loopback on their
# own, and Docker's embedded DNS resolves these two names inside the network to the proxy - so
# `https://auth.localhost:8443` is one string that means the same thing in a browser on this machine
# and inside the admin UI's container. That property is load-bearing: the issuer is compared byte
# for byte, and a value that resolves in only one of the two places breaks the other silently.
#
# If your resolver does not handle `*.localhost` - glibc alone does not, systemd-resolved and every
# major browser do - add them to /etc/hosts:
#
#   127.0.0.1  auth.localhost admin.localhost
#
AUTH_HOST=auth.localhost
ADMIN_HOST=admin.localhost

# Published on 127.0.0.1 only, and the container listens on the same number, because the issuer URL
# carries the port and has to be dereferenceable from both sides of that boundary.
HTTPS_PORT=8443

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Who administers the directory
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
# One id, spelled once, used four times: the role `migrate` seeds, the role the first account holds,
# the server's `ADMIN_ROLES`, and the admin UI's copy of the same string. Nothing in the library
# knows this name - `AdminRoleScopePolicy` compares it ordinally against whatever the token carries
# - so `Administrator` and `administrator` are two different roles and only one of them will work.
ADMIN_ROLE=administrator

# What the admin UI is registered as in the server's `CLIENTS`. An opaque identifier; it is not a
# URL and it is not derived from anything.
ADMIN_CLIENT_ID=boltway-adminbff

# The first account. Created once, by the `init` service, because there is no registration endpoint
# and federated sign-in refuses an unknown identity by default - without it the stack comes up
# healthy with no way in at all.
#
# Its password is generated and printed once, into `docker compose logs init`. It cannot be shown
# again; `docker compose run --rm auth set-password <handle>` mints a new one.
#
# `example.test` per RFC 2606, so this address cannot be somebody's.
FIRST_ACCOUNT_HANDLE=admin
FIRST_ACCOUNT_EMAIL=admin@example.test

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Operational
# ─────────────────────────────────────────────────────────────────────────────────────────────────

# `json` (the default in the image, structured and vendor-neutral), `cloud-logging` (the same fields
# under Google Cloud Logging's names), or `simple` (the framework's human-readable console).
# `simple` here because the reader is a person with a terminal open. A value that is none of the
# three is refused at startup rather than resolved to the default.
LOG_FORMAT=simple

# How many proxies stand in front of the authorization server. One - the `proxy` service. Behind a
# CDN as well it is 2. Getting it wrong is silent in both directions: too low and every request is
# attributed to the proxy's neighbour, so the per-source login limit becomes per-deployment; too
# high and the client gets to choose which address it is throttled as.
FORWARDED_HOPS=1

# Appended to each page's <title>. The browser tab is how somebody with several servers open decides
# which one is asking them for a password.
UI_PRODUCT_NAME=Boltway

# Sign-out. On in this image, off in the library's own defaults - a deployment that never heard of
# the setting should get a way to end a session rather than not.
END_SESSION=true

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Lifetimes
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
# Unset leaves the library's default, and empty reads as unset. One spelling only - a count and a
# unit - because a bare number leaves "seconds or minutes" to whoever reads it next, and .NET's own
# parser reads `30` as thirty *days*.
#
# ACCESS_TOKEN_LIFETIME=15m
# REFRESH_TOKEN_LIFETIME=30d
# AUTH_CODE_LIFETIME=60s
# SESSION_REVALIDATION=5m
# REAUTH_FRESHNESS=15m

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Settings this stack does not turn on
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
# Naming one here is not enough - `docker-compose.yml` has to pass it through on an `environment:`
# line as well. The list is in `hosts/Boltway.AuthorizationServer.Host/README.md`; these are the ones
# worth knowing about from here:
#
#   SELF_SERVICE           routes /account/* and advertises `users:self`
#   SELF_SERVICE_PAGES     routes /me/* - the browser pages, cookie-authenticated
#   PASSWORD_RECOVERY      the reset-by-email flows. Refused at startup without a mail sender
#   SMTP_HOST · SMTP_FROM  what registers that sender. Unset, this image sends no mail at all
#   INTROSPECTION          RFC 7662, for a resource server that wants revocation to take effect
#   REVOCATION             RFC 7009. Off, and confidential clients only
#   USERINFO               on by default; the variable exists to turn it off. Left on here because
#                          the admin UI reads `preferred_username` from it - turned off, its header
#                          names whoever is signed in by their 26-character subject instead
#   GOOGLE_CLIENT_ID       and GOOGLE_CLIENT_SECRET. Startup refuses one without the other
#   DEFAULT_ROLES          what an account created without a role holds. Left unset here on
#                          purpose: set to ADMIN_ROLE it would make every new account an
#                          administrator
#   OTEL_EXPORTER_OTLP_ENDPOINT   unset means no exporter is created at all, rather than one
#                          retrying forever against an address nothing answers
#
# Two of them are **not** safe to pass through as an empty string, which is why they are not already
# on an `environment:` line with an empty default:
#
#   UI_STYLESHEETS         empty means "serve the pages unstyled", which is a real setting
#   UI_DEFAULT_LOCALE      tested with `is not null`, so empty turns localization on for a culture
#                          named ""

# ─────────────────────────────────────────────────────────────────────────────────────────────────
# Supplying your own secrets instead of the generated ones
# ─────────────────────────────────────────────────────────────────────────────────────────────────
#
# Uncomment and fill, and the entrypoints will prefer these over what `init` minted. Do not commit
# the file you put them in.
#
#   SIGNING_KEYS                    a JSON *array* of key entries. Mint one with
#                                   `docker compose run --rm auth new-key 2026-08`, and put the
#                                   object it prints inside brackets - the verb prints one object
#                                   and this setting wants an array.
#   REFRESH_TOKEN_DERIVATION_KEY    32 random bytes, base64: `openssl rand -base64 32`. Every
#                                   refresh token is derived from it, so changing it invalidates
#                                   every one outstanding.
#   CLIENT_SECRET                   the admin UI's half of `new-client-secret`. The other half, the
#                                   sha256, goes in the server's CLIENTS - which this stack builds
#                                   in the `init` service, so overriding one without the other is a
#                                   sign-in that fails with `invalid_client`.
#
# SIGNING_KEYS=
# REFRESH_TOKEN_DERIVATION_KEY=
# CLIENT_SECRET=
