# Code style for the authorization server.
#
# Most of this is ordinary formatting. The rules under "Protocol safety" are
# not: they are requirements from the spec expressed as analyzer diagnostics,
# so that violating one fails the build rather than waiting for review.

root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,jsonc,yml,yaml,csproj,props,targets}]
indent_style = space
indent_size = 2

[*.cs]

# --- Protocol safety -------------------------------------------------------
#
# CA1307/CA1310: an overload of Equals/StartsWith/IndexOf without an explicit
# StringComparison uses the current culture. Every comparison in this codebase
# that touches a redirect_uri, client_id, issuer, iss or resource identifier is
# required by RFC 3986 6.2.1 to be Simple String Comparison - ordinal, on the
# raw string. Culture-sensitive comparison is not that, and the difference is
# invisible until it is a widened redirect match.
dotnet_diagnostic.CA1307.severity = error
dotnet_diagnostic.CA1310.severity = error
dotnet_diagnostic.CA1309.severity = error

# CA5350/CA5351: weak crypto. There is no legitimate use of a broken hash here.
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error

# CA5394: Random is not a source of authorization codes, refresh tokens, or
# client secrets. Those come from RandomNumberGenerator (N-16).
dotnet_diagnostic.CA5394.severity = error

# CA2007: missing ConfigureAwait is fine in ASP.NET Core; there is no
# synchronization context to deadlock against.
dotnet_diagnostic.CA2007.severity = none

# CA1848: high-performance LoggerMessage delegates are worth it on the hot
# protocol paths but not everywhere; keep it visible without failing the build.
dotnet_diagnostic.CA1848.severity = suggestion

# --- Nullability -----------------------------------------------------------
# These are how "this was validated upstream" stays a compiler-checked claim.
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8618.severity = error

# --- Style -----------------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:error
csharp_using_directive_placement = outside_namespace:suggestion
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

[tests/**.cs]
# Test names describe the requirement being proven, which makes them long. CA1707 itself is
# switched off for test projects in tests/Directory.Build.props - by project rather than by
# filename, because a filename pattern misses shared contract and fixture files.
max_line_length = 160

[**/Migrations/*.cs]
# `dotnet ef migrations add` writes a block-scoped namespace, and IDE0161 is an error everywhere
# else in this repository. Reformatting the file by hand works exactly until the next `migrations
# add`, which writes it back. The two sibling files the tool emits (`*.Designer.cs` and the model
# snapshot) already carry an <auto-generated/> header and are skipped by every analyzer; the
# migration itself does not, which is the only reason this stanza is needed.
#
# Narrow deliberately: this turns off ONE formatting rule in ONE directory of tool output. The
# protocol-safety rules above are not scoped by path and still apply here.
dotnet_diagnostic.IDE0161.severity = none

# EF Core scaffolds these, and every composite key or index arrives as an inline array literal.
# CA1861 is about repeated allocation on a path that runs often; a migration runs once per database,
# and hand-editing generated files to satisfy an analyzer means re-editing them after every scaffold.
[**/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none
