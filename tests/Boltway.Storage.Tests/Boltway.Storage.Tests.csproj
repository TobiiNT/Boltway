<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Not packable, like every other test project. This said the opposite, because the contracts
      lived here and "a customer writing their own store runs the same tests" was true of them and
      not of this project: what packed carried Microsoft.NET.Test.Sdk, the xunit runner, coverlet,
      a runtimeconfig.json and the seven InMemory*Tests below, and a customer running `dotnet test`
      ran those and read the results as being about their store.

      The contracts are in testing/Boltway.Storage.Testing now, which is what a customer
      references. What is left here is the derivations, which are this repository's tests.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Boltway.Storage.InMemory\Boltway.Storage.InMemory.csproj" />
    <ProjectReference Include="..\..\testing\Boltway.Storage.Testing\Boltway.Storage.Testing.csproj" />
  </ItemGroup>

</Project>
